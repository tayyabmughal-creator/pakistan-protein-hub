# Pak Nutrition storefront (Next.js).
#
# Install once, by hand, on the VPS — see deploy/STOREFRONT_SETUP.md, which
# fills in the REPLACE_* placeholders before copying this into
# /etc/systemd/system/. Do not copy it unedited.
#
# Until this unit exists the deploy workflow skips restarting it, so adding
# the storefront to the repository does not break deploys for a box that has
# not been set up yet.

[Unit]
Description=Pak Nutrition storefront (Next.js)
After=network.target
# The storefront renders by calling the API. Starting before gunicorn is up
# just means the first few requests fail; Wants (not Requires) so a backend
# restart does not take the storefront down with it.
Wants=proteinhub-backend.service

[Service]
Type=simple

# Match to the account that owns the checkout; the deploy workflow builds as
# this user and systemd must run as the same one or .next will be unreadable.
User=REPLACE_WITH_DEPLOY_USER
Group=REPLACE_WITH_DEPLOY_USER
WorkingDirectory=/REPLACE/WITH/PROJECT_PATH/storefront

Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
# Server-side only, never reaches a browser. Bound to loopback because nginx
# is the only thing that should be able to reach either process directly.
Environment=API_BASE_URL=http://127.0.0.1:8000

# The deploy user's own Node 22 (deploy/install-storefront-node.sh), never the
# shared system Node 18 that `/usr/bin/env node` would find. The deploy
# workflow builds with the same binary, so build and runtime always match.
Environment=PATH=/home/REPLACE_WITH_DEPLOY_USER/.local/node22/bin:/usr/bin:/bin

# next.config sets output: "standalone" (the Docker image needs it), and
# `next start` does not support that mode. Run the standalone server, as the
# Dockerfile does; `npm run assemble:standalone` copies .next/static and
# public into it after each build. PORT and HOSTNAME above bind it.
ExecStart=/home/REPLACE_WITH_DEPLOY_USER/.local/node22/bin/node .next/standalone/server.js

Restart=always
RestartSec=5

# A Next.js process that has wedged still holds its port, so systemd cannot
# tell it apart from a healthy one. The cheap version: restart on exit, and
# nginx serves the SPA for storefront pages while it is down (error_page in
# deploy/nginx-storefront.conf).
KillSignal=SIGTERM
TimeoutStopSec=20

# Hardening. The storefront reads its own build output and talks to the API;
# it has no reason to write anywhere or to see the rest of the filesystem.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/REPLACE/WITH/PROJECT_PATH/storefront/.next
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=paknutrition-storefront

[Install]
WantedBy=multi-user.target
