# Where the Django API lives, as seen from the Next.js server process.
# Server-side only — this is never exposed to the browser.
API_BASE_URL=http://127.0.0.1:8000

# The storefront's own public origin. Used for canonical URLs, Open Graph and
# the sitemap. Getting this wrong means every canonical tag points at the
# wrong host, which is worse than having none.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hostname serving /media (product images). Must be set in production or
# next/image will refuse to load them — the allow-list is deliberate.
# NEXT_PUBLIC_MEDIA_HOST=paknutrition.pk
