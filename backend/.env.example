# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Must be at least 50 characters in production, or the app refuses to start.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=shop.example.com,www.shop.example.com
CSRF_TRUSTED_ORIGINS=https://shop.example.com,https://www.shop.example.com
CORS_ALLOWED_ORIGINS=https://shop.example.com,https://www.shop.example.com
FRONTEND_URL=https://shop.example.com
BACKEND_PUBLIC_URL=https://shop.example.com
ADMIN_URL=secure-admin/

# Docker/VPS production path should use PostgreSQL via the `db` service hostname.
POSTGRES_DB=paknutrition
POSTGRES_USER=paknutrition
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Cache and background task broker. Optional: without REDIS_URL the cache is a
# no-op and Celery tasks run inline, so the app still works — just without the
# benefit of moving slow notification calls off the request. Production
# configuration validation requires PostgreSQL but not Redis.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Logging. `json` is one object per line with a request id; `text` is readable.
LOG_LEVEL=INFO
LOG_FORMAT=json

# Error monitoring. Entirely opt-in — nothing is sent anywhere without a DSN.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0

# Where backup_database writes by default.
BACKUP_DIR=/backups

# Set to 0 only to get a shell on an already-broken box. It downgrades the
# production configuration check from "refuse to start" to a warning.
CONFIG_CHECK_STRICT=1

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=no-reply@shop.example.com
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=PakNutrition <no-reply@shop.example.com>
ORDER_NOTIFICATION_EMAIL_ENABLED=True
ORDER_NOTIFICATION_SMS_ENABLED=False
ADMIN_PUSH_NOTIFICATIONS_ENABLED=True
EXPO_PUSH_ACCESS_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Online payment. Keep disabled until payments/VERIFICATION_CHECKLIST.md passes
# against a real Safepay sandbox — the webhook signature scheme is unconfirmed.
SAFEPAY_ENABLED=False
SAFEPAY_ENV=sandbox
SAFEPAY_API_KEY=
SAFEPAY_SHARED_SECRET=
SAFEPAY_SOURCE=paknutrition
# Webhook verification. Falls back to SAFEPAY_SHARED_SECRET when unset.
# The header name and algorithm MUST be confirmed against the Safepay dashboard.
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_WEBHOOK_SIGNATURE_HEADER=HTTP_X_SFPY_SIGNATURE
SAFEPAY_WEBHOOK_SIGNATURE_ALGORITHM=sha512

EASYPAISA_ACCOUNT=03xxxxxxxxx
JAZZCASH_ACCOUNT=03xxxxxxxxx
BANK_ACCOUNT_TITLE=PakNutrition
BANK_ACCOUNT_NUMBER=0000000000000000
BANK_NAME=Bank Name
MANUAL_PAYMENT_NOTE=Complete the transfer first, then enter the transaction reference so PakNutrition can verify your payment quickly.

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
